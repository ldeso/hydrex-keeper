# Copy to config.env. It holds public values only: the secrets live in Secret Manager.

# A project for the job alone. It must not be the key's project.
KEEPER_PROJECT=

REGION=us-central1

# The Cloud Run job. Its scheduler job and alerts are named after it.
JOB=hydrex-keeper

KEEPER_SA_NAME=hydrex-keeper
SCHEDULER_SA_NAME=hydrex-keeper-scheduler

# `version` in hydrex-keeper-key's record/keeper.json.
KMS_KEY_VERSION=

# KlimaVeTokenConduitExecutor on Base.
MODULE=0x750973E0CB728C3112561Bc8E9b235afA9B17E81

# The immutable conduit, and the proposer that signs its votes: `address` and `version` in hydrex-keeper-key's
# record/proposer.json. Set all three, or leave all three empty to vote for the Klima conduit alone.
CONDUIT=0x692c323B425A9DfeebE302F56168a7798D93EAC5
PROPOSER=0x52c139f60452B93e1211F116BD43B28d7AfC2bCa
PROPOSER_KMS_KEY_VERSION=

# Secret Manager secret with one Base RPC URL, or several separated by commas. Public nodes are tried after them.
RPC_SECRET=base-rpc-url

# Secret Manager secret with an Alchemy API key, a second price source.
ALCHEMY_SECRET=alchemy-api-key

# Optional. Secret Manager secret with a CoinGecko Demo API key, a third price source.
COINGECKO_SECRET=

# Gets an email when a run fails.
ALERT_EMAIL=
