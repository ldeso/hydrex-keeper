# Copy to config.env. Public material only.

# Project for the job only; it must differ from the key's project.
KEEPER_PROJECT=

# Region of the Cloud Run job and the Cloud Scheduler jobs.
REGION=us-central1

# Cloud Run job; its scheduler job and alerts are named after it.
JOB=hydrex-keeper

# Service accounts that run the job and that start it.
KEEPER_SA_NAME=hydrex-keeper
SCHEDULER_SA_NAME=hydrex-keeper-scheduler

# `version` in hydrex-keeper-key's record/keeper.json.
KMS_KEY_VERSION=

# KlimaVeTokenConduitExecutor on Base.
MODULE=0x750973E0CB728C3112561Bc8E9b235afA9B17E81

# Secret Manager secret holding the Base RPC URL, or several separated by commas. Public nodes are tried after them.
RPC_SECRET=base-rpc-url

# Secret Manager secret holding an Alchemy API key, to price rewards with Alchemy as well as DefiLlama.
ALCHEMY_SECRET=alchemy-api-key

# Optional: Secret Manager secret holding a CoinGecko Demo API key, a third price source.
COINGECKO_SECRET=

# Receives an email when an execution fails.
ALERT_EMAIL=
